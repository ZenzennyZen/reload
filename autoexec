local function loadKeybinds()
	if not hasFileIO
		or not isfile(KEYBIND_FILE)
	then
		return
	end

	local ok, data =
		pcall(
			readfile,
			KEYBIND_FILE
		)

	if not ok
		or not data
		or data == ""
	then
		return
	end

	local decodedOk, decoded =
		pcall(
			function()
				return HttpService:JSONDecode(data)
			end
		)

	if not decodedOk
		or type(decoded) ~= "table"
	then
		return
	end

	for name, keyName in pairs(decoded) do
		if (name == "autoGrab"
				or name == "cframeSpeed")
			and type(keyName) == "string"
		then
			local success, code =
				pcall(
					function()
