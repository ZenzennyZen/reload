local function makeSlider(
	name,
	labelText,
	y,
	minVal,
	maxVal,
	initial,
	onChange
)
	local container = Instance.new("Frame")
	container.Name = name
	container.Size = UDim2.new(1, -PAD * 2, 0, 68)
	container.Position = UDim2.new(0, PAD, 0, y)
