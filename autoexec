--------------------------------------------------
-- PANEL DRAG
--------------------------------------------------

local pDragging = false
local pDragStart = nil
local pStartPos = nil

dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
	then
		pDragging = true
		pDragStart = input.Position
		pStartPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				pDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not pDragging then return end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch
	then
		return
	end

	if not pDragStart or not pStartPos then
		return
	end

	local delta = input.Position - pDragStart

	main.Position = UDim2.new(
		pStartPos.X.Scale,
		pStartPos.X.Offset + delta.X,
		pStartPos.Y.Scale,
		pStartPos.Y.Offset + delta.Y
	)
end)

--------------------------------------------------
-- MOVEMENT LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function(dt)
	updateESP()

	local character = player.Character
	if not character then return end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return
	end

	if hideEnabled then
		humanoid.AutoRotate = false
	end

	--------------------------------------------------
	-- AUTO GRAB
	--------------------------------------------------

	if autoGrabEnabled then
		updateAutoGrab(root, dt)
	end

	--------------------------------------------------
	-- FORWARD
	--------------------------------------------------

	if forwardActive then
		if os.clock() >= forwardEnd then
			forwardActive = false

			setButton(forwardButton, false, "READY", C_MUTED)

			if hideEnabled then
				setStatus("Hide Item  •  17 Speed", true)
			elseif cframeEnabled then
				setStatus(
					"CFrame Speed  •  "
					.. tostring(CFRAME_SPEED),
					true
				)
			else
				setStatus("CFrame: OFF", false)
			end

			refreshCollision()
		else
			local direction = flatLook(root)

			root.CFrame =
				root.CFrame
				+ direction * FORWARD_SPEED * dt
		end

	--------------------------------------------------
	-- WALK
	--------------------------------------------------

	else
		local movement = humanoid.MoveDirection

		if movement.Magnitude > 0.05 then
			local direction =
				Vector3.new(
					movement.X,
					0,
					movement.Z
				)

			if direction.Magnitude > 0.01 then
				direction = direction.Unit

				if cframeEnabled then
					root.CFrame =
						root.CFrame
						+ direction * CFRAME_SPEED * dt

				elseif hideEnabled then
					root.CFrame =
						root.CFrame
						+ direction * HIDE_ITEM_SPEED * dt
				end
			end
		end
	end

	--------------------------------------------------
	-- VERTICAL OWNERSHIP
	--------------------------------------------------

	if hideEnabled then
		applyHideRotation(root)

		applyHidePlacement(
			character,
			root,
			humanoid,
			dt
		)

	elseif cframeEnabled then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end)

