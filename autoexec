--------------------------------------------------
-- HIDE ITEM TARGET
--------------------------------------------------

local function getHideTarget(character, floorY)
	local bodyMin,
		bodyMax,
		bodyHeight =
		bodyYBounds(character)

	if not bodyMin
		or not bodyMax
		or not bodyHeight
	then
		return nil, nil
	end

	local targetMin =
		floorY
		- (bodyHeight * HIDE_ITEM_SUBMERGE)
		+ HIDE_ITEM_FLOOR_GAP

	local tool = equippedTool(character)

	if tool then
		local _, toolMax =
			toolYBounds(tool)

		if toolMax then
			local itemTargetMax =
				floorY - HIDE_ITEM_FLOOR_GAP

			local requiredMin =
				bodyMin
				+ (itemTargetMax - toolMax)

			if requiredMin < targetMin then
				targetMin = requiredMin
			end
		end
	end

	return targetMin, bodyMin
end

--------------------------------------------------
-- HIDE ITEM PLACEMENT
--------------------------------------------------

local function applyHidePlacement(
	character,
	root,
	humanoid,
	dt
)
	if not hideEnabled then
		return
	end

	local bodyMin, bodyMax =
		bodyYBounds(character)

	if not bodyMin or not bodyMax then
		return
	end

	updateFloor(character, root, dt)

	if cachedFloorY == nil then
		return
	end

	hideVelocityY =
		math.max(
			hideVelocityY
				- (HIDE_ITEM_GRAVITY * dt),
			-HIDE_ITEM_MAX_FALL_SPEED
		)

	local targetMin, currentMin =
		getHideTarget(
			character,
			cachedFloorY
		)

	if not targetMin then
		return
	end

	local correction = targetMin - currentMin
	local moveY = 0

	if correction < 0 then
		moveY =
			math.max(
				correction,
				hideVelocityY * dt
			)
	else
		moveY = math.min(correction, 30)
	end

	if math.abs(moveY) > 0.001 then
		root.CFrame =
			root.CFrame
			+ Vector3.new(0, moveY, 0)
	end

	if math.abs(correction)
		<= math.abs(moveY) + 0.001
	then
		hideVelocityY = 0
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	updateHideCamera(humanoid)
end

