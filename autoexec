local espFolder = Instance.new("Folder")
espFolder.Name = "ESPFolder"
espFolder.Parent = gui

local espBoxes = {}

local ESP_PARTS = {
	Head = true, Torso = true,
	UpperTorso = true, LowerTorso = true,
	["Left Arm"] = true, ["Right Arm"] = true,
	["Left Leg"] = true, ["Right Leg"] = true,
	LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true,
	LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
	RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
	HumanoidRootPart = true,
}

local function clearESP()
	for _, child in ipairs(espFolder:GetChildren()) do
		child:Destroy()
	end

	table.clear(espBoxes)
	table.clear(espPartCache)
end

local function getESPParts(target)
	local character = target.Character
	if not character then return nil end

	local entry = espPartCache[target]
	if entry and entry.character == character then
		return entry.parts
	end

	local parts = {}
	local descendants = character:GetDescendants()

	for i = 1, #descendants do
		local part = descendants[i]

		if part:IsA("BasePart")
			and ESP_PARTS[part.Name]
		then
			parts[#parts + 1] = part
		end
	end

	espPartCache[target] = {
		character = character,
		parts = parts,
	}

	return parts
end

local function createESP(target)
	if target == player then return nil end

	local holder = Instance.new("Frame")
	holder.Name = target.Name
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Visible = false
	holder.Parent = espFolder

	local box = Instance.new("Frame")
	box.Size = UDim2.fromScale(1, 1)
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Parent = holder

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Thickness = 1.5
	boxStroke.Color = Color3.fromRGB(0, 255, 160)
	boxStroke.Parent = box

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 80, 0, 16)
	nameLabel.Position = UDim2.new(0.5, 0, 0, -2)
	nameLabel.AnchorPoint = Vector2.new(0.5, 1)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = target.Name
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeTransparency = 0
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Parent = holder

	return holder
end

local function updateESP()
	if not espEnabled then return end

	local camera = workspace.CurrentCamera
	if not camera then return end

	local updated = {}
	local players = Players:GetPlayers()

	for i = 1, #players do
		local target = players[i]

		if target ~= player and target.Character then
			local character = target.Character

			local root =
				character:FindFirstChild("HumanoidRootPart")

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if root and humanoid and humanoid.Health > 0 then
				updated[target] = true

				if not espBoxes[target]
					or not espBoxes[target].Parent
				then
					espBoxes[target] = createESP(target)
				end

				local holder = espBoxes[target]

				local rootScreen =
					camera:WorldToViewportPoint(root.Position)

				if holder and rootScreen.Z > 0 then
					local parts = getESPParts(target)

					if parts and #parts > 0 then
						local minX = math.huge
						local maxX = -math.huge
						local minY = math.huge
						local maxY = -math.huge
						local found = false

						for pi = 1, #parts do
							local part = parts[pi]

							if part.Parent then
								local half = part.Size * 0.5
								local cf = part.CFrame

								local hx, hy, hz =
									half.X, half.Y, half.Z

								local points = {
									Vector3.new(-hx, -hy, -hz),
									Vector3.new(-hx, -hy, hz),
									Vector3.new(-hx, hy, -hz),
									Vector3.new(-hx, hy, hz),
									Vector3.new(hx, -hy, -hz),
									Vector3.new(hx, -hy, hz),
									Vector3.new(hx, hy, -hz),
									Vector3.new(hx, hy, hz),
								}

								for ci = 1, 8 do
									local screen =
										camera:WorldToViewportPoint(
											cf * points[ci]
										)

									if screen.Z > 0 then
										if screen.X < minX then minX = screen.X end
										if screen.X > maxX then maxX = screen.X end
										if screen.Y < minY then minY = screen.Y end
										if screen.Y > maxY then maxY = screen.Y end
										found = true
									end
								end
							end
						end

						if found then
							holder.Size = UDim2.fromOffset(
								math.clamp(maxX - minX, 8, 400),
								math.clamp(maxY - minY, 12, 500)
							)
							holder.Position = UDim2.fromOffset(minX, minY)
							holder.Visible = true
						else
							holder.Visible = false
						end
					else
						holder.Visible = false
					end
				elseif holder then
					holder.Visible = false
				end
			end
		end
	end

	for target, holder in pairs(espBoxes) do
		if not updated[target] then
			holder:Destroy()
			espBoxes[target] = nil
			espPartCache[target] = nil
		end
	end
end

