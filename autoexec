local FLIP =
	CFrame.Angles(
		0,
		0,
		math.pi
	)

local function flatLook(root)
	local look =
		root.CFrame.LookVector

	local flat =
		Vector3.new(
			look.X,
			0,
			look.Z
		)

	if flat.Magnitude < 0.01 then
		flat =
			Vector3.new(
				0,
				0,
				-1
			)
	end

	return flat.Unit
end

local function partYBounds(part)
	local half =
		part.Size * 0.5

	local cf =
		part.CFrame

	local corners = {
		Vector3.new(-half.X, -half.Y, -half.Z),
		Vector3.new(-half.X, -half.Y, half.Z),
		Vector3.new(-half.X, half.Y, -half.Z),
		Vector3.new(-half.X, half.Y, half.Z),
		Vector3.new(half.X, -half.Y, -half.Z),
		Vector3.new(half.X, -half.Y, half.Z),
		Vector3.new(half.X, half.Y, -half.Z),
		Vector3.new(half.X, half.Y, half.Z),
	}

	local minY = math.huge
	local maxY = -math.huge

	for _, corner in ipairs(corners) do
		local point = cf * corner
		minY = math.min(minY, point.Y)
		maxY = math.max(maxY, point.Y)
	end

	return minY, maxY
end

local function bodyYBounds(character)
	local minY = math.huge
	local maxY = -math.huge

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart")
			and not object:FindFirstAncestorOfClass("Tool")
		then
			local a, b =
				partYBounds(object)

			minY = math.min(minY, a)
			maxY = math.max(maxY, b)
		end
	end

	if minY == math.huge then
		return nil, nil, nil
	end

	return minY, maxY, maxY - minY
end

local function equippedTool(character)
	for _, child in ipairs(
		character:GetChildren()
	) do
		if child:IsA("Tool") then
			return child
		end
	end

	return nil
end

local function toolYBounds(tool)
	if not tool then
		return nil, nil
	end

	local minY = math.huge
	local maxY = -math.huge

	for _, object in ipairs(
		tool:GetDescendants()
	) do
		if object:IsA("BasePart") then
			local a, b =
				partYBounds(object)

			minY = math.min(minY, a)
			maxY = math.max(maxY, b)
		end
	end

	if minY == math.huge then
		return nil, nil
	end

	return minY, maxY
end

--------------------------------------------------
-- FLOOR DETECTOR
--------------------------------------------------

local function rayParams(character)
	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		character
	}

	params.IgnoreWater = false

	return params
end

local function validFloor(
	hit,
	rootY,
	upward
)
	if not hit then
		return false
	end

	if upward then
		return hit.Normal.Y <=
			-FLOOR_NORMAL_MIN
	end

	if hit.Normal.Y <
		FLOOR_NORMAL_MIN
	then
		return false
	end

	if hit.Position.Y >
		rootY + FLOOR_REJECT_ABOVE_ROOT
	then
		return false
	end

	return true
end

local function findFloorBelow(
	character,
	root
)
	local params =
		rayParams(character)

	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(FLOOR_PROBE_RADIUS, 0, 0),
		Vector3.new(-FLOOR_PROBE_RADIUS, 0, 0),
		Vector3.new(0, 0, FLOOR_PROBE_RADIUS),
		Vector3.new(0, 0, -FLOOR_PROBE_RADIUS),
	}

	local best = nil
	local bestDistance = math.huge
	local originY = root.Position.Y + 0.75

	for _, offset in ipairs(offsets) do
		local origin =
			Vector3.new(
				root.Position.X + offset.X,
				originY,
				root.Position.Z + offset.Z
			)

		local hit =
			workspace:Raycast(
				origin,
				Vector3.new(
					0,
					-FLOOR_RAY_DISTANCE,
					0
				),
				params
			)

		if validFloor(hit, root.Position.Y, false) then
			local distance =
				math.abs(
					hit.Position.Y
					- root.Position.Y
				)

			if distance < bestDistance then
				bestDistance = distance
				best = hit
			end
		end
	end

	return best
end

local function recoverFloor(
	character,
	root
)
	if cachedFloorY == nil then
		return nil
	end

	if root.Position.Y >=
		cachedFloorY
		- FLOOR_HARD_RECOVERY_DISTANCE
	then
		return nil
	end

	local params =
		rayParams(character)

	local hit =
		workspace:Raycast(
			root.Position
				- Vector3.new(0, 2, 0),
			Vector3.new(
				0,
				FLOOR_UPWARD_RECOVERY,
				0
			),
			params
		)

	if validFloor(hit, root.Position.Y, true) then
		return hit
	end

	return nil
end

local function updateFloor(
	character,
	root,
	dt
)
	floorTimer = floorTimer - dt

	if floorTimer > 0
		and cachedFloorY ~= nil
	then
		return
	end

	floorTimer = FLOOR_REFRESH

	local hit =
		findFloorBelow(character, root)

	if not hit then
		hit = recoverFloor(character, root)
	end

	if not hit then
		return
	end

	local newFloorY = hit.Position.Y

	if cachedFloorY == nil then
		cachedFloorY = newFloorY
		pendingFloorY = nil
		pendingFloorCount = 0
		return
	end

	if math.abs(
		newFloorY - cachedFloorY
	) <= 2.5 then

		cachedFloorY = newFloorY
		pendingFloorY = nil
		pendingFloorCount = 0
		return
	end

	if pendingFloorY
		and math.abs(
			pendingFloorY - newFloorY
		) <= 0.6
	then
		pendingFloorCount =
			pendingFloorCount + 1
	else
		pendingFloorY = newFloorY
		pendingFloorCount = 1
	end

	if pendingFloorCount >= 2 then
		cachedFloorY = pendingFloorY
		pendingFloorY = nil
		pendingFloorCount = 0
	end
end

