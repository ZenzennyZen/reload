local function trackPrompt(prompt)
	if trackedPromptSet[prompt] then
		return
	end

	trackedPromptSet[prompt] = true
	trackedPrompts[#trackedPrompts + 1] = prompt
end

local function untrackPrompt(prompt)
	trackedPromptSet[prompt] = nil
end

local function doFullPromptScan()
	table.clear(trackedPrompts)
	table.clear(trackedPromptSet)

	local descendants = workspace:GetDescendants()

	for i = 1, #descendants do
		local obj = descendants[i]

		if obj:IsA("ProximityPrompt") then
			trackedPromptSet[obj] = true
			trackedPrompts[#trackedPrompts + 1] = obj
		end
	end
end

local function compactPrompts()
	local write = 1
	local count = #trackedPrompts

	for read = 1, count do
		local p = trackedPrompts[read]

		if p
			and trackedPromptSet[p]
			and p.Parent
		then
			trackedPrompts[write] = p
			write = write + 1
		elseif p then
			trackedPromptSet[p] = nil
		end
	end

	for i = count, write, -1 do
		trackedPrompts[i] = nil
	end
end

local function startAutoGrab()
	doFullPromptScan()

	promptAddConn =
		workspace.DescendantAdded:Connect(
			function(obj)
				if obj:IsA("ProximityPrompt") then
					trackPrompt(obj)
				end
			end
		)

	promptRemoveConn =
		workspace.DescendantRemoving:Connect(
			function(obj)
				if obj:IsA("ProximityPrompt") then
					untrackPrompt(obj)
				end
			end
		)

	autoGrabTimer = 0
	autoGrabSweepTimer = AUTO_GRAB_SWEEP_INTERVAL
	table.clear(promptRetries)
end

local function stopAutoGrab()
	if promptAddConn then
		promptAddConn:Disconnect()
		promptAddConn = nil
	end

	if promptRemoveConn then
		promptRemoveConn:Disconnect()
		promptRemoveConn = nil
	end

	table.clear(trackedPrompts)
	table.clear(trackedPromptSet)
	table.clear(promptCooldowns)
	table.clear(promptRetries)
end

local function promptWorldPosition(prompt)
	local current = prompt.Parent
	local depth = 0

	while current and depth < 12 do
		if current:IsA("BasePart") then
			return current.Position
		elseif current:IsA("Attachment") then
			return current.WorldPosition
		end

		current = current.Parent
		depth = depth + 1
	end

	return nil
end

local function findNearestPrompt(root)
	local rootPos = root.Position
	local rootX = rootPos.X
	local rootY = rootPos.Y
	local rootZ = rootPos.Z

	local now = os.clock()

	local nearest = nil
	local nearestSqr = math.huge

	local list = trackedPrompts
	local count = #list

	for i = 1, count do
		local prompt = list[i]

		if prompt and prompt.Enabled then
			local last = promptCooldowns[prompt]

			if not last
				or now - last
					>= AUTO_GRAB_PROMPT_COOLDOWN
			then
				local pos =
					promptWorldPosition(prompt)

				if pos then
					local dx = pos.X - rootX
					local dy = pos.Y - rootY
					local dz = pos.Z - rootZ

					local sqr =
						dx * dx
						+ dy * dy
						+ dz * dz

					local maxDist =
						math.max(
							prompt
								.MaxActivationDistance,
							AUTO_GRAB_MIN_RADIUS
						)

					if sqr
						<= maxDist * maxDist
						and sqr < nearestSqr
					then
						nearest = prompt
						nearestSqr = sqr
					end
				end
			end
		end
	end

	return nearest
end

local function tryFirePrompt(prompt, forceEnabled)
	if not prompt or not prompt.Parent then
		return false
	end

	local originalHold = prompt.HoldDuration
	local originalLos = prompt.RequiresLineOfSight
	local originalEnabled = prompt.Enabled

	if originalHold > 0 then
		prompt.HoldDuration = 0
	end

	if originalLos then
		prompt.RequiresLineOfSight = false
	end

	if forceEnabled and not originalEnabled then
		prompt.Enabled = true
	end

	local ok = pcall(function()
		prompt:InputHoldBegin()
		prompt:InputHoldEnd()
	end)

	if originalHold > 0 then
		prompt.HoldDuration = originalHold
	end

	if originalLos then
		prompt.RequiresLineOfSight = originalLos
	end

	if forceEnabled and not originalEnabled then
		prompt.Enabled = originalEnabled
	end

	return ok
end

local function firePrompt(prompt)
	if not prompt or not prompt.Parent then
		return
	end

	local now = os.clock()

	tryFirePrompt(prompt, false)

	promptCooldowns[prompt] = now

	promptRetries[#promptRetries + 1] = {
		prompt = prompt,
		at = now + 0.05,
	}
end

local function processRetries()
	if #promptRetries == 0 then
		return
	end

	local now = os.clock()
	local write = 1
	local count = #promptRetries

	for read = 1, count do
		local entry = promptRetries[read]

		if entry.at <= now then
			local p = entry.prompt

			if p and p.Parent then
				tryFirePrompt(p, true)
				promptCooldowns[p] = now
			end
		else
			promptRetries[write] = entry
			write = write + 1
		end
	end

	for i = count, write, -1 do
		promptRetries[i] = nil
	end
end

local function updateAutoGrab(root, dt)
	if not autoGrabEnabled then
		return
	end

	processRetries()

	autoGrabSweepTimer =
		autoGrabSweepTimer - dt

	if autoGrabSweepTimer <= 0 then
		autoGrabSweepTimer =
			AUTO_GRAB_SWEEP_INTERVAL

		compactPrompts()
	end

	autoGrabTimer =
		autoGrabTimer - dt

	if autoGrabTimer > 0 then
		return
	end

	autoGrabTimer = AUTO_GRAB_INTERVAL

	local nearest =
		findNearestPrompt(root)

	if nearest then
		firePrompt(nearest)
	end
end

