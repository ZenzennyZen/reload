local function getServers(placeId)
	local url = string.format(
		"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
		placeId
	)

	local ok, response = pcall(function()
		return HttpService:JSONDecode(game:HttpGet(url))
	end)

	if not ok or not response or not response.data then
		return nil
	end

	return response.data
end

local function resetHop(chip)
	setButton(hopButton, false, chip or "⇄", C_MUTED)

	task.delay(1.2, function()
		hopping = false
		setButton(hopButton, false, "⇄", C_MUTED)
	end)
end

local reexecQueued = false

local function queueReexecute()
	if not AUTO_REEXEC or reexecQueued then
		return
	end

	local queue =
		queue_on_teleport
		or (syn and syn.queue_on_teleport)
		or (fluxus and fluxus.queue_on_teleport)

	if type(queue) ~= "function" then
		return
	end

	local code = string.format([[
		if not game:IsLoaded() then game.Loaded:Wait() end
		task.wait(1)

		local src = nil
		local file = %q
		local url = %q

		if file ~= "" and type(isfile) == "function" and isfile(file) then
			local ok, data = pcall(readfile, file)
			if ok and data and data ~= "" then
				src = data
			end
		end

		if not src and url ~= "" then
			local ok, data = pcall(function()
				return game:HttpGet(url)
			end)
			if ok and data and data ~= "" then
				src = data
			end
		end

		if src then
			local fn = loadstring(src)
			if fn then
				fn()
			end
		end
	]], REEXEC_FILE, REEXEC_URL)

	local ok = pcall(queue, code)

	if ok then
		reexecQueued = true
	end
end

local function serverHop()
	if hopping then return end

	hopping = true

	setButton(hopButton, true, "SEARCH", C_ACCENT)
	setStatus("Finding server...", true)

	local placeId = game.PlaceId
	local current = game.JobId

	pushRecent(current)

	if current and current ~= "" then
		visitedServers[current] = os.time()
	end

	pruneLog(visitedServers)

	local servers = getServers(placeId)

	if not servers then
		setStatus("Server list unavailable", false)
		resetHop("FAIL")
		return
	end

	local candidates = {}

	for _, server in ipairs(servers) do
		local id = server.id

		if type(id) == "string"
			and id ~= ""
			and id ~= current
			and server.playing < server.maxPlayers
			and not isRecent(id)
		then
			local stamp = visitedServers[id]

			candidates[#candidates + 1] = {
				server = server,
				id = id,
				stamp = stamp or 0,
				visited = stamp ~= nil,
			}
		end
	end

	if #candidates == 0 then
		for _, server in ipairs(servers) do
			local id = server.id

			if type(id) == "string"
				and id ~= ""
				and id ~= current
				and server.playing < server.maxPlayers
			then
				local stamp = visitedServers[id]

				candidates[#candidates + 1] = {
					server = server,
					id = id,
					stamp = stamp or 0,
					visited = stamp ~= nil,
				}
			end
		end
	end

	if #candidates == 0 then
		setStatus("No other servers found", false)
		resetHop("EMPTY")
		return
	end

	table.sort(candidates, function(a, b)
		if a.visited ~= b.visited then
			return not a.visited
		end
		return a.stamp < b.stamp
	end)

	local fresh = {}

	for _, candidate in ipairs(candidates) do
		if not candidate.visited then
			fresh[#fresh + 1] = candidate
		end
	end

	local selected

	if #fresh > 0 then
		selected = fresh[math.random(1, #fresh)].server
	else
		selected = candidates[1].server
	end

	markVisited(selected.id)
	pushRecent(selected.id)

	setButton(hopButton, true, "JOIN", C_ACCENT)

	setStatus(
		"Joining " .. selected.id:sub(1, 8) .. "...",
		true
	)

	queueReexecute()

	local teleported = pcall(function()
		TeleportService:TeleportToPlaceInstance(
			placeId,
			selected.id,
			player
		)
	end)

	if not teleported then
		visitedServers[selected.id] = nil
		saveLog(visitedServers)

		setStatus("Teleport error", false)
		resetHop("FAIL")
	end
end

