local function pushRecent(id)
	if not id or id == "" then
		return
	end

	for i = #recentHops, 1, -1 do
		if recentHops[i] == id then
			table.remove(
				recentHops,
				i
			)
		end
	end

	table.insert(
		recentHops,
		1,
		id
	)

	while #recentHops > MAX_RECENT_HOPS do
		table.remove(
			recentHops
		)
	end
end

local function isRecent(id)
	for _, v in ipairs(recentHops) do
		if v == id then
			return true
		end
	end

	return false
end

