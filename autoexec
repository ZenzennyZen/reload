local savedCollision = {}
local savedCharacter = nil

local function getCharacter()
	return player.Character
end

local function saveCollision(character)
	if not character then return end

	if savedCharacter ~= character then
		table.clear(savedCollision)
		savedCharacter = character
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart")
			and savedCollision[object] == nil
		then
			savedCollision[object] = {
				CanCollide = object.CanCollide,
				CanTouch = object.CanTouch,
				CanQuery = object.CanQuery
			}
		end
	end
end

local function disableCharacterCollision(character)
	if not character then
		return
	end

	saveCollision(character)

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart") then
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
		end
	end
end

local function restoreCharacterCollision(character)
	if not character then
		return
	end

	for object, state in pairs(
		savedCollision
	) do
		if object and object.Parent then
			object.CanCollide = state.CanCollide
			object.CanTouch = state.CanTouch
			object.CanQuery = state.CanQuery
		end
	end

	table.clear(savedCollision)
	savedCharacter = nil
end

local function refreshCollision()
	local character = getCharacter()

	if not character then
		return
	end

	if cframeEnabled
		or hideEnabled
		or forwardActive
	then
		disableCharacterCollision(
			character
		)
	else
		restoreCharacterCollision(
			character
		)
	end
end

--------------------------------------------------
-- GEOMETRY
