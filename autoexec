local LOG_FOLDER = "ServerHopLogs"
local LOG_BASE = string.format("history_%d_%s", game.PlaceId, LOG_NAMESPACE)
local LOG_JSON = LOG_FOLDER .. "/" .. LOG_BASE .. ".json"
local LOG_TEXT = LOG_FOLDER .. "/" .. LOG_BASE .. ".txt"

local hasFileIO =
	type(writefile) == "function" and
	type(readfile) == "function" and
	type(isfile) == "function"

local function ensureFolder()
	if not hasFileIO then return end

	if type(isfolder) == "function"
		and not isfolder(LOG_FOLDER)
	then
		pcall(makefolder, LOG_FOLDER)
	end
end

local function pruneLog(log)
	local now = os.time()

	for id, stamp in pairs(log) do
		if type(id) ~= "string"
			or type(stamp) ~= "number"
			or now - stamp >= LOG_MAX_AGE
		then
			log[id] = nil
		end
	end
end

local function saveLog(log)
	if not hasFileIO then return end

	ensureFolder()

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(log)
	end)

	if ok then
		pcall(writefile, LOG_JSON, encoded)
	end

	local entries = {}

	for id, stamp in pairs(log) do
		entries[#entries + 1] = {
			id = id,
			ts = stamp
		}
	end

	table.sort(
		entries,
		function(a, b)
			return a.ts < b.ts
		end
	)

	local lines = {
		"# Server Hop Log",
		"# Place: " .. tostring(game.PlaceId),
		"# Namespace: " .. LOG_NAMESPACE,
		"# Auto-resets after 1 hour"
	}

	for _, entry in ipairs(entries) do
		lines[#lines + 1] =
			string.format(
				"[%s] %s",
				os.date(
					"%Y-%m-%d %H:%M:%S",
					entry.ts
				),
				entry.id
			)
	end

	pcall(
		writefile,
		LOG_TEXT,
		table.concat(lines, "\n")
	)
end

local function loadLog()
	if not hasFileIO then
		return {}
	end

	ensureFolder()

	if not isfile(LOG_JSON) then
		return {}
	end

	local ok, data =
		pcall(
			readfile,
			LOG_JSON
		)

	if not ok
		or not data
		or data == ""
	then
		return {}
	end

	local decodedOk, decoded =
		pcall(
			function()
				return HttpService:JSONDecode(data)
			end
		)

	if decodedOk
		and type(decoded) == "table"
	then
		return decoded
	end

	return {}
end

